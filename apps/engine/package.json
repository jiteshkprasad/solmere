{
  "name": "@npcworld/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "headless": "tsx src/main.ts --headless",
    "season:export": "tsx src/replay/export.ts",
    "brain:test": "tsx src/brain/openrouter/selftest.ts",
    "bakeoff": "tsx src/brain/openrouter/bakeoff.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@npcworld/schema": "workspace:*",
    "dotenv": "^16.4.5",
    "hono": "^4.6.10",
    "@hono/node-server": "^1.13.7",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5",
    "nanoid": "^5.0.8",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/seedrandom": "^3.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.4"
  }
}
