{
  "name": "npcworld",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:engine": "pnpm --filter @npcworld/engine dev",
    "dev:web": "pnpm --filter @npcworld/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate:content": "tsx scripts/validate-content.ts",
    "gen:audio": "tsx scripts/gen-audio.ts",
    "master:audio": "tsx scripts/master-audio.ts",
    "audio": "pnpm gen:audio && pnpm master:audio"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
